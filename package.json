{
  "name": "yokdil-hedef",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "build:mobile": "vite build --mode mobile",
    "mobile:add:android": "npm run build:mobile && npx cap add android && npm run mobile:assets:android && npx cap sync android",
    "mobile:add:ios": "npm run build:mobile && npx cap add ios && npm run mobile:assets:ios && npx cap sync ios",
    "mobile:sync": "npm run build:mobile && npx cap sync",
    "mobile:assets": "node scripts/generate-native-assets.mjs && npx capacitor-assets generate",
    "mobile:open:android": "npx cap open android",
    "mobile:open:ios": "npx cap open ios",
    "mobile:assets:android": "node scripts/generate-native-assets.mjs && npx capacitor-assets generate --android --iconBackgroundColor '#172446' --splashBackgroundColor '#172446'",
    "mobile:assets:ios": "node scripts/generate-native-assets.mjs && npx capacitor-assets generate --ios --iconBackgroundColor '#172446' --splashBackgroundColor '#172446'"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@capacitor/core": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/browser": "^8.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/assets": "^4.0.0",
    "sharp": "^0.34.4"
  },
  "description": "YDS ve YÖKDİL için web, Android ve iOS sınav hazırlık uygulaması",
  "engines": {
    "node": ">=22"
  }
}
